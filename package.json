{
  "name": "my-file-explorer",
  "productName": "MyFileExplorer",
  "version": "0.1.0",
  "description": "Windows-first Electron + React file manager: tabs, rich previews (incl. A1111/ComfyUI metadata), curated context menu, opt-in indexed search.",
  "main": "./out/main/index.js",
  "author": "MyFileExplorer",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "icons": "node scripts/make-icons.mjs",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "dist": "npm run build:win"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "koffi": "^3.1.4",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "music-metadata": "^11.14.0",
    "sharp": "^0.34.0",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}

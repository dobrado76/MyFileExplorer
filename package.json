{
  "name": "my-file-explorer",
  "productName": "MyFileExplorer",
  "desktopName": "MyFileExplorer",
  "version": "0.7.2",
  "description": "Windows-first Electron + React file manager: tabs, rich previews (incl. A1111/ComfyUI metadata), Everything-inspired opt-in search, curated/customizable context menu, remotes (FTP/SFTP), OS drag-out, in-app Recycle Bin.",
  "main": "./out/main/index.js",
  "author": "MyFileExplorer",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml --publish never",
    "dev:wayland": "bash ./scripts/run-linux-dev.sh",
    "dev:linux": "bash ./scripts/run-linux-dev.sh",
    "install:linux": "bash ./scripts/install-linux-bundle.sh",
    "run:linux": "bash ./scripts/run-linux-appimage.sh",
    "run:unpacked": "bash ./scripts/run-linux-unpacked.sh",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "prepare": "node scripts/install-git-hooks.mjs",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "node scripts/patch-filerobot-crop.mjs",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml --publish never",
    "dist": "node scripts/dist.mjs",
    "dist:nobump": "node scripts/dist.mjs --no-bump",
    "dist:linux": "npm run build:linux"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "7zip-min": "^3.0.1",
    "ag-psd": "^31.0.2",
    "basic-ftp": "6.2.0",
    "dompurify": "^3.4.12",
    "ffmpeg-static": "^5.3.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "koffi": "^3.1.4",
    "konva": "^9.3.18",
    "lucide-react": "^1.30.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "music-metadata": "^11.14.0",
    "node-unrar-js": "^2.0.2",
    "onnxruntime-web": "^1.22.0",
    "react-filerobot-image-editor": "^5.0.0-beta.159",
    "react-konva": "^19.2.5",
    "sharp": "^0.34.0",
    "ssh2": "1.17.0",
    "styled-components": "^6.4.4",
    "tar-stream": "^3.2.0",
    "three": "^0.185.1",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/ffmpeg-static": "^3.0.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "1.15.5",
    "@types/tar-stream": "^3.1.4",
    "@types/three": "^0.185.4",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
